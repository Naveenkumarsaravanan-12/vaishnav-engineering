# ============================================================================
# VAISHNAV ENGINEERING — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets, private tokens, or production credentials to Git.
# ============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Canonical Public Website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics & Monitoring (Optional Placeholders)
# NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Contact & Inquiry API Endpoint (Optional)
# CONTACT_FORM_SUBMISSION_URL=

